{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "Rust 1.84 is the workspace MSRV and moves only with an ADR (ADR 0018).",
      "matchDepNames": ["rust"],
      "matchFileNames": [".github/workflows/ci.yml", ".github/workflows/release.yml"],
      "matchCurrentValue": "/^1\\.84(?:\\.\\d+)?$/",
      "enabled": false
    },
    {
      "description": "sha2 0.11 requires Rust 1.85, above the workspace MSRV.",
      "matchManagers": ["cargo"],
      "matchDepNames": ["sha2"],
      "allowedVersions": "<0.11"
    },
    {
      "description": "yaml-rust2 0.12 requires Rust 1.85, above the workspace MSRV.",
      "matchManagers": ["cargo"],
      "matchDepNames": ["yaml-rust2"],
      "allowedVersions": "<0.12"
    }
  ]
}
